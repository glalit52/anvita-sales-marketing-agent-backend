# Copy to .env. Every setting is prefixed ANVITA_ (see app/core/config.py for the full list).
ANVITA_ENV=development
ANVITA_DATABASE_URL=postgresql+asyncpg://anvita:anvita@localhost:5432/anvita
ANVITA_APP_BASE_URL=http://localhost:3000
ANVITA_CORS_ORIGINS=http://localhost:3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ANVITA_JWT_SECRET=dev-only-change-me-dev-only-change-me

# Without a key the agent runs on a deterministic offline model (dev only).
ANVITA_ANTHROPIC_API_KEY=
ANVITA_LLM_CONVERSATION_MODEL=claude-sonnet-5-5
ANVITA_LLM_FAST_MODEL=claude-haiku-5-5

# Payments: "test" (simulated checkout) or "razorpay".
ANVITA_PAYMENTS_PROVIDER=test
ANVITA_RAZORPAY_KEY_ID=
ANVITA_RAZORPAY_KEY_SECRET=
ANVITA_RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API webhook verification.
ANVITA_WHATSAPP_VERIFY_TOKEN=
ANVITA_WHATSAPP_APP_SECRET=
